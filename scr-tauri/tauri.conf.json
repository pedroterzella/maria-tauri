{
  "productName": "MARIA",
  "version": "1.0.0",
  "identifier": "com.maria.app",
  "build": {
    "frontendDist": "../scr"
  },
  "app": {
    "windows": [
      {
        "title": "MARIA",
        "width": 900,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://api.groq.com https://cdn.jsdelivr.net; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
